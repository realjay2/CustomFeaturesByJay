{
  "rewrites": [
    {
      "source": "/:path*.lua",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(Volcano|Delta|Xeno|Solara|Potassium|Volt)"
        }
      ],
      "destination": "/:path*.lua"
    },
    {
      "source": "/:path*.lua",
      "destination": "/404.html"
    }
  ]
}
