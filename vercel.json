{
  "routes": [
    {
      "src": ".*\\.lua$",
      "status": 403,
      "headers": {
        "Content-Type": "text/plain"
      },
      "body": "Access Denied"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.lua",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}
